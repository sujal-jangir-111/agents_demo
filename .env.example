# ASI:One
ASI1_API_KEY=
ASI1_MODEL=asi1-mini

# GitHub (fine-grained PAT: Contents RW + Pull requests RW on the demo repo only)
GITHUB_TOKEN=
DEMO_REPO_FULL_NAME=your-org/sentinel-target
DEMO_SERVICE_URL=https://sentinel-target.onrender.com 
DEMO_ADMIN_TOKEN=change-me
# Optional extra repos the executor may write to (comma-separated); default is DEMO_REPO_FULL_NAME only
GITHUB_WRITE_ALLOWLIST=

# Agent seeds (unique, long, secret)
ORCHESTRATOR_SEED=
WATCHDOG_SEED=
DETECTIVE_SEED=
SCANNER_SEED=
EXECUTOR_SEED=

# Payment / chain
ORCHESTRATOR_WALLET_ADDRESS=fetch1...
REMEDIATION_PRICE_ATESTFET=100000000000000000
DORADO_EXPLORER_BASE=https://explore-dorado.fetch.ai/transactions
# DEV ONLY: skip the 0.1 FET change-control payment (approval in chat still required)
SKIP_PAYMENT=false

# Remediation (gatekeeper retry loop)
PATCH_MAX_ATTEMPTS=3

# Watchdog
WATCHDOG_TARGETS=
WATCHDOG_INTERVAL_SECONDS=60

# Blast radius assumptions
TRAFFIC_RPM=120
AVG_ORDER_VALUE_USD=40
CONVERSION_RATE=0.03
SLA_TARGET=0.999
